    {
        "name": "edit-social-target",
        "title": "Edit Social Target Tool",
        "description": "Edit the text and optional title of one existing remote publication target. Requires target_id and content. Checks provider edit capabilities and returns the provider action result; may update public content.",
        "inputSchema": {
            "properties": {
                "target_id": {
                    "description": "required; integer; min:1",
                    "minimum": 1,
                    "type": "integer"
                },
                "content": {
                    "description": "required; string; max:60000",
                    "maxLength": 60000,
                    "type": "string"
                },
                "title": {
                    "description": "sometimes; string; max:255",
                    "maxLength": 255,
                    "type": "string"
                },
                "idempotency_key": {
                    "description": "nullable; string; max:128",
                    "maxLength": 128,
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "type": "object",
            "required": [
                "target_id",
                "content"
            ]
        },
        "annotations": {
            "title": "Edit Social Target Tool",
            "readOnlyHint": false,
            "destructiveHint": true,
            "openWorldHint": true
        }
    },
